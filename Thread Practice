package core.multithreading;

class Name extends Thread{
    String name;
    Name(String name){
        this.name=name;
    }
    public void run(){
        for(int i=0;i<10;i++){
            System.out.println("I am "+this.name);
            try{
                Thread.sleep(1000);
            }catch (Exception e){
                
            }
        }
    }
}
public class Demo {
    public static void main(String[] args) {
        Name name=new Name("Ajay Kumar");
        Name name2=new Name("Tiwari Ji");
        name.start();
        name2.start();

    }
}
